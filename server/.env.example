# Environment Variables for Server (Backend)

# MongoDB Connection String
# For production, use MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb://localhost:27017/blitz-india

# Production example:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/blitz-india?retryWrites=true&w=majority

# JWT Secret (Generate a strong random string for production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Port (Vercel will use their own port, but keep for local development)
PORT=5000

# Node Environment
NODE_ENV=production

# Frontend URL (Update to your Vercel frontend URL)
CLIENT_URL=http://localhost:3000

# Production example:
# CLIENT_URL=https://your-app.vercel.app

# Session Secret (Generate a strong random string for production)
SESSION_SECRET=your_session_secret_here_change_in_production

# File Upload Configuration (Optional - for Cloudinary/AWS S3)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
